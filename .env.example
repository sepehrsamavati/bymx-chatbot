BYMX_CACHE_STORAGE="./data/cache"
BYMX_HTTP_PROXY="" # HTTP proxy used in calls (undici Proxy Agent)
BYMX_FILE_CLEANUP_AGE="5" # Delete unused files after 'n' minutes

BYMX_FILE_UPLOAD_LIMIT_PERIOD="20" # Minutes
BYMX_FILE_UPLOAD_LIMIT_COUNT="3" # Limit file uploading per user 'n' count in 'm' minutes

BYMX_FILE_PROCESSING_LIMIT_PERIOD="30" # Minutes
BYMX_FILE_PROCESSING_LIMIT_COUNT="10" # Limit file processing per user 'n' count in 'm' minutes

